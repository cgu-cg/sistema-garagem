{
  "name": "sistema-garagem",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "start": "node apps/api/dist/index.js",
    "lint": "tsc -b apps/web && tsc --noEmit -p apps/api"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("COLABORADOR")
  garagem   String?  @map("garagem")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  abastecimentos             Abastecimento[]
  solturas                   Soltura[]
  controlesOperacionais      ControleOperacional[]
  abastecimentoCarroSessions AbastecimentoCarroSession[]
  groups                     Group[]
  reservasTerminais          ReservaTerminal[]
  ciBloqueios                CiBloqueio[]
  manutencaoCarros           ManutencaoCarro[]

  folhasCIRegistradas FolhaCI[] @relation("FolhaResponsavel")
  regularizacoesCIIniciadas FolhaCI[] @relation("CIRegularizacaoResponsavel")
  folhasCIFinalizadas FolhaCI[] @relation("CIFinalizador")
  itensFolhaCIRegistrados ItemFolhaCI[] @relation("ItemFolhaResponsavel")
  estadosManutencaoRegistrados EstadoManutencao[] @relation("EstadoManutencaoResponsavel")

  @@map("users")
}

model Bus {
  id        Int      @id @default(autoincrement())
  plate     String   @unique @map("placa")
  prefix    String   @map("prefixo")
  model     String   @map("modelo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  solturasRealizadas  Soltura[] @relation("RealizedBuses")
  solturasProgramadas Soltura[] @relation("ProgrammedBuses")

  @@map("buses")
}

model Abastecimento {
  id        Int      @id @default(autoincrement())
  litersT1  Decimal  @map("litros_t1")
  fotoT1    String   @map("foto_t1")
  litersT2  Decimal  @map("litros_t2")
  fotoT2    String   @map("foto_t2")
  litersT3  Decimal? @map("litros_t3")
  fotoT3    String?  @map("foto_t3")
  garagem   String?  @map("garagem")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("abastecimentos")
}

model FolhaSoltura {
  id            Int      @id @default(autoincrement())
  garagem       String   @db.NVarChar(10)
  escalaTipo    String   @map("escala_tipo") @db.NVarChar(10)
  turno         String   @db.NVarChar(10)
  dataOperacao  String   @map("data_operacao") @db.NVarChar(10)
  status        String   @db.NVarChar(20)
  revisao       Int      @default(1)
  conteudo      String   @db.NVarChar(Max)
  responsavelId Int      @map("responsavel_id")
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @map("created_at") @db.DateTime2
  updatedAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @updatedAt @map("updated_at") @db.DateTime2

  @@unique([garagem, escalaTipo, turno, dataOperacao], map: "UQ_soltura_folha_contexto")
  @@map("soltura_folha")
}

model Soltura {
  id              Int      @id @default(autoincrement())
  busId           Int?     @map("bus_id")
  programmedBusId Int?     @map("programmed_bus_id")
  scheduleId      String?  @map("schedule_id")
  carroProgramado String?  @map("carro_programado")
  carroRealizado  String?  @map("carro_realizado")
  linha           String
  tabela          String
  driverCode      String?  @map("driver_code")
  driverName      String?  @map("motorista")
  saidaGaragem    String?  @map("saida_garagem")
  inicioLinha     String?  @map("inicio_linha")
  horaLiberacao   String?  @map("hora_liberacao")
  garagem         String?  @map("garagem")
  turno           String?  @map("turno")
  escalaTipo      String?  @map("escala_tipo")
  dataOperacao    String?  @map("data_operacao")
  substituido     Boolean? @default(false) @map("substituido")
  historicoTrocas String?  @map("historico_trocas")
  status          String?  @default("LIBERADO") @map("status")
  notes           String?  @map("observacoes")
  userId          Int?     @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  bus           Bus?  @relation("RealizedBuses", fields: [busId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programmedBus Bus?  @relation("ProgrammedBuses", fields: [programmedBusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("solturas")
}

model ControleOperacional {
  id           Int      @id @default(autoincrement())
  carro        String   @map("carro")
  linha        String   @map("linha")
  garagem      String   @map("garagem")
  foto1        String   @map("foto1")
  foto2        String?  @map("foto2")
  foto3        String?  @map("foto3")
  dataInsercao DateTime @default(now()) @map("data_insercao")
  userId       Int      @map("user_id")

  user User @relation(fields: [userId], references: [id])

  @@map("controleOperacional")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String   @default("[]") // JSON string of route paths (e.g. ["/home", "/soltura"])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("groups")
}

model AbastecimentoCarroSession {
  id            Int       @id @default(autoincrement())
  matricula     String    @map("matricula")
  dthIniAbastec DateTime  @default(now()) @map("dth_ini_abastec")
  dthFimAbastec DateTime? @map("dth_fim_abastec")
  status        String    @default("EM_ANDAMENTO") @map("status") // "EM_ANDAMENTO" | "FINALIZADO"
  garagem       String?   @map("garagem")

  // Leituras iniciais das bombas (Suporta até 6 bombas)
  b1Ini Decimal? @map("b1_ini")
  b2Ini Decimal? @map("b2_ini")
  b3Ini Decimal? @map("b3_ini")
  b4Ini Decimal? @map("b4_ini")
  b5Ini Decimal? @map("b5_ini")
  b6Ini Decimal? @map("b6_ini")

  // Leituras finais das bombas
  b1Fim Decimal? @map("b1_fim")
  b2Fim Decimal? @map("b2_fim")
  b3Fim Decimal? @map("b3_fim")
  b4Fim Decimal? @map("b4_fim")
  b5Fim Decimal? @map("b5_fim")
  b6Fim Decimal? @map("b6_fim")

  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User                     @relation(fields: [userId], references: [id])
  items AbastecimentoCarroItem[]

  @@map("abastecimento_carro_sessions")
}

model AbastecimentoCarroItem {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  carro     String   @map("carro")
  liters    Decimal  @map("litros")
  bomba     String   @map("bomba") // e.g. "B.01", "B.02"
  foto      String   @map("foto")
  matricula String   @map("matricula")
  garagem   String?  @map("garagem")
  dataHora  DateTime @default(now()) @map("data_hora")

  session AbastecimentoCarroSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("abastecimento_carro_items")
}

model ReservaTerminal {
  id        Int      @id @default(autoincrement())
  carro     String   @map("carro")
  tipo      String   @map("tipo") // "VERMELHO" | "AZUL" | "CORINGA" | "MICRO" | "ARTICULADO"
  terminal  String   @map("terminal")
  dataHora  DateTime @default(now()) @map("datahora")
  garagem   String?  @default("VCG") @map("garagem")
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([garagem, terminal])
  @@map("reservas_terminais")
}

model CiBloqueio {
  id                   String   @id @map("id") @db.NVarChar(100)
  prefixo              String   @map("prefixo") @db.NVarChar(10)
  garagem              String   @map("garagem") @db.NVarChar(10)
  consorciada          String   @map("consorciada") @db.NVarChar(10)
  categoria            String   @map("categoria") @db.NVarChar(20)
  subTipo              String?  @map("sub_tipo") @db.NVarChar(50)
  horarioReforco       String?  @map("horario_reforco") @db.NVarChar(20)
  motivo               String?  @map("motivo") @db.NVarChar(255)
  dataBloqueio         String   @map("data_bloqueio") @db.NVarChar(20)
  horaBloqueio         String?  @map("hora_bloqueio") @db.NVarChar(10)
  gravidade            String?  @default("ALTA") @map("gravidade") @db.NVarChar(10)
  responsavel          String?  @map("responsavel") @db.NVarChar(100)
  observacoes          String?  @map("observacoes") @db.NVarChar(255)
  status               String?  @default("BLOQUEADO") @map("status") @db.NVarChar(20)
  dataLiberacao        String?  @map("data_liberacao") @db.NVarChar(50)
  motivoLiberacao      String?  @map("motivo_liberacao") @db.NVarChar(255)
  responsavelLiberacao String?  @map("responsavel_liberacao") @db.NVarChar(100)
  userId               Int?     @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([prefixo])
  @@index([status])
  @@index([garagem])
  @@map("ci_bloqueios")
}

model ManutencaoCarro {
  id          String   @id @map("id") @db.NVarChar(100)
  prefixo     String   @map("prefixo") @db.NVarChar(10)
  consorciada String   @map("consorciada") @db.NVarChar(10)
  observacao  String   @default("") @map("observacao") @db.NVarChar(255)
  bloqueado   Boolean  @default(false) @map("bloqueado")
  emExecucao  Boolean  @default(false) @map("em_execucao")
  liberado    Boolean  @default(false) @map("liberado")
  data        String   @map("data") @db.NVarChar(20)
  userId      Int?     @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([data])
  @@index([prefixo])
  @@index([data, prefixo])
  @@map("manutencao_carros")
}

// DATA-001C4: runtime opt-in CI_NOVO_FLUXO_GARAGENS; provisionamento manual.
// CHECKs e UNIQUEs filtrados: scripts/sql/data-001c4-provisionamento.sql.
// Nao substituir filtros por @@unique geral/nullable. Legado preservado.
// Prisma 6.10 nao aceita precisao em @db.DateTime2; SQL fixa DATETIME2(3).

model CicloOperacional {
  id                      Int                @id(map: "PK_ciclo_operacional") @default(autoincrement()) @map("id") @db.Int
  garagem                 String             @map("garagem") @db.NVarChar(10)
  dataOperacional         DateTime           @map("data_operacional") @db.Date
  origem                  String             @map("origem") @db.NVarChar(20)
  inicializacaoPrevistaEm DateTime           @map("inicializacao_prevista_em") @db.DateTime2
  inicializadoEm          DateTime           @map("inicializado_em") @db.DateTime2
  referenciaOrigem        String?            @map("referencia_origem") @db.NVarChar(255)
  createdAt               DateTime           @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_ciclo_operacional_created_at") @map("created_at") @db.DateTime2
  updatedAt               DateTime           @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_ciclo_operacional_updated_at") @updatedAt @map("updated_at") @db.DateTime2

  folhasPreparadas        FolhaCI[]          @relation("CicloFolhas")
  estadosManutencao       EstadoManutencao[]

  @@unique([garagem, dataOperacional], map: "UQ_ciclo_operacional_garagem_data")
  @@unique([id, garagem], map: "UQ_ciclo_operacional_id_garagem")
  @@map("ciclo_operacional")
}

model FolhaCI {
  id                      Int               @id(map: "PK_folha_ci") @default(autoincrement()) @map("id") @db.Int
  garagem                 String            @map("garagem") @db.NVarChar(10)
  dataFolha               DateTime          @map("data_folha") @db.Date
  status                  String            @map("status") @db.NVarChar(20)
  origem                  String            @map("origem") @db.NVarChar(20)
  cicloPreparacaoId       Int?              @map("ciclo_preparacao_id") @db.Int
  folhaOrigemId           Int?              @map("folha_origem_id") @db.Int
  tituloColunaAdicional   String?           @map("titulo_coluna_adicional") @db.NVarChar(30)
  inicializacaoPrevistaEm DateTime?         @map("inicializacao_prevista_em") @db.DateTime2
  inicializadaEm          DateTime?         @map("inicializada_em") @db.DateTime2
  finalizacaoPrevistaEm   DateTime?         @map("finalizacao_prevista_em") @db.DateTime2
  finalizadaEm            DateTime?         @map("finalizada_em") @db.DateTime2
  regularizacaoIniciadaEm DateTime?         @map("regularizacao_iniciada_em") @db.DateTime2
  regularizacaoIniciadaPorId Int?           @map("regularizacao_iniciada_por_id") @db.Int
  finalizadaPorId         Int?              @map("finalizada_por_id") @db.Int
  referenciaOrigem        String?           @map("referencia_origem") @db.NVarChar(255)
  responsavelRegistroId   Int?              @map("responsavel_registro_id") @db.Int
  createdAt               DateTime          @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_folha_ci_created_at") @map("created_at") @db.DateTime2
  updatedAt               DateTime          @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_folha_ci_updated_at") @updatedAt @map("updated_at") @db.DateTime2

  cicloPreparacao         CicloOperacional? @relation("CicloFolhas", fields: [cicloPreparacaoId, garagem], references: [id, garagem], onDelete: NoAction, onUpdate: NoAction, map: "FK_folha_ci_ciclo_garagem")
  folhaOrigem             FolhaCI?          @relation("OrigemFolha", fields: [folhaOrigemId, garagem], references: [id, garagem], onDelete: NoAction, onUpdate: NoAction, map: "FK_folha_ci_origem_garagem")
  folhasDerivadas         FolhaCI[]         @relation("OrigemFolha")
  responsavelRegistro     User?             @relation("FolhaResponsavel", fields: [responsavelRegistroId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_folha_ci_responsavel")
  regularizacaoIniciadaPor User?             @relation("CIRegularizacaoResponsavel", fields: [regularizacaoIniciadaPorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_folha_ci_regularizacao_usuario")
  finalizadaPor           User?             @relation("CIFinalizador", fields: [finalizadaPorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_folha_ci_finalizador")
  itens                   ItemFolhaCI[]

  @@unique([garagem, dataFolha], map: "UQ_folha_ci_garagem_data")
  @@unique([id, garagem], map: "UQ_folha_ci_id_garagem")
  @@index([folhaOrigemId, garagem], map: "IX_folha_ci_folha_origem_garagem")
  @@map("folha_ci")
}

model ItemFolhaCI {
  id                    Int      @id(map: "PK_item_folha_ci") @default(autoincrement()) @map("id") @db.Int
  folhaId               Int      @map("folha_id") @db.Int
  chaveItem             String   @map("chave_item") @db.UniqueIdentifier
  categoria             String   @map("categoria") @db.NVarChar(20)
  tipoPosicao           String?  @map("tipo_posicao") @db.NVarChar(10)
  ordemPosicao          Int?     @map("ordem_posicao") @db.Int
  prefixo               String   @map("prefixo") @db.NVarChar(10)
  consorciada           String?  @map("consorciada") @db.NVarChar(10)
  subTipo               String?  @map("sub_tipo") @db.NVarChar(50)
  horarioReforco        String?  @map("horario_reforco") @db.NVarChar(20)
  motivo                String?  @map("motivo") @db.NVarChar(255)
  observacoes           String?  @map("observacoes") @db.NVarChar(255)
  horaBloqueio          String?  @map("hora_bloqueio") @db.NVarChar(10)
  gravidade             String?  @map("gravidade") @db.NVarChar(10)
  responsavel           String?  @map("responsavel") @db.NVarChar(100)
  statusItem            String?  @map("status_item") @db.NVarChar(20)
  dataLiberacao         String?  @map("data_liberacao") @db.NVarChar(50)
  motivoLiberacao       String?  @map("motivo_liberacao") @db.NVarChar(255)
  responsavelLiberacao  String?  @map("responsavel_liberacao") @db.NVarChar(100)
  responsavelRegistroId Int?     @map("responsavel_registro_id") @db.Int
  createdAt             DateTime @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_item_folha_ci_created_at") @map("created_at") @db.DateTime2
  updatedAt             DateTime @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_item_folha_ci_updated_at") @updatedAt @map("updated_at") @db.DateTime2
  dataBloqueio          DateTime? @map("data_bloqueio") @db.Date

  folha                 FolhaCI  @relation(fields: [folhaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_item_folha_ci_folha")
  responsavelRegistro   User?    @relation("ItemFolhaResponsavel", fields: [responsavelRegistroId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_item_folha_ci_responsavel")

  @@unique([folhaId, chaveItem], map: "UQ_item_folha_ci_folha_chave")
  @@index([folhaId, categoria], map: "IX_item_folha_ci_folha_categoria")
  @@index([folhaId, prefixo], map: "IX_item_folha_ci_folha_prefixo")
  @@map("item_folha_ci")
}

model EstadoManutencao {
  id                    Int              @id(map: "PK_estado_manutencao_ciclo") @default(autoincrement()) @map("id") @db.Int
  cicloId               Int              @map("ciclo_id") @db.Int
  prefixo               String           @map("prefixo") @db.NVarChar(10)
  consorciada           String           @map("consorciada") @db.NVarChar(10)
  bloqueado             Boolean          @default(false, map: "DF_estado_manutencao_ciclo_bloqueado") @map("bloqueado") @db.Bit
  emExecucao            Boolean          @default(false, map: "DF_estado_manutencao_ciclo_em_execucao") @map("em_execucao") @db.Bit
  liberado              Boolean          @default(false, map: "DF_estado_manutencao_ciclo_liberado") @map("liberado") @db.Bit
  observacaoBloqueio    String?          @map("observacao_bloqueio") @db.NVarChar(255)
  observacaoOficina     String?          @map("observacao_oficina") @db.NVarChar(255)
  responsavelRegistroId Int?             @map("responsavel_registro_id") @db.Int
  createdAt             DateTime         @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_estado_manutencao_ciclo_created_at") @map("created_at") @db.DateTime2
  updatedAt             DateTime         @default(dbgenerated("SYSUTCDATETIME()"), map: "DF_estado_manutencao_ciclo_updated_at") @updatedAt @map("updated_at") @db.DateTime2

  ciclo                 CicloOperacional @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_estado_manutencao_ciclo_ciclo")
  responsavelRegistro   User?            @relation("EstadoManutencaoResponsavel", fields: [responsavelRegistroId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_estado_manutencao_ciclo_responsavel")

  @@unique([cicloId, prefixo], map: "UQ_estado_manutencao_ciclo_ciclo_prefixo")
  @@map("estado_manutencao_ciclo")
}

model EscalaCarros {
  id            Int                @id @default(autoincrement())
  garagem       String             @db.NVarChar(10)
  escalaTipo    String             @map("escala_tipo") @db.NVarChar(10)
  turno         String             @db.NVarChar(10)
  revisao       Int                @default(1)
  responsavelId Int                @map("responsavel_id")
  createdAt     DateTime           @default(dbgenerated("SYSUTCDATETIME()")) @map("created_at") @db.DateTime2
  updatedAt     DateTime           @default(dbgenerated("SYSUTCDATETIME()")) @updatedAt @map("updated_at") @db.DateTime2
  itens         ItemEscalaCarros[]

  @@unique([garagem, escalaTipo, turno], map: "UQ_escala_carros_contexto")
  @@map("escala_carros")
}

model ItemEscalaCarros {
  id        Int          @id @default(autoincrement())
  escalaId  Int          @map("escala_id")
  chaveItem String       @map("chave_item") @db.NVarChar(100)
  ordem     Int
  conteudo  String       @db.NVarChar(Max)
  escala    EscalaCarros @relation(fields: [escalaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([escalaId, chaveItem], map: "UQ_item_escala_carros_chave")
  @@unique([escalaId, ordem], map: "UQ_item_escala_carros_ordem")
  @@map("item_escala_carros")
}

// Substituicoes de programacao, nunca registros de despacho/liberacao.
model EscalaDiaria {
  id            Int      @id @default(autoincrement())
  garagem       String   @db.NVarChar(10)
  escalaTipo    String   @map("escala_tipo") @db.NVarChar(10)
  turno         String   @db.NVarChar(10)
  dataOperacao  String   @map("data_operacao") @db.NVarChar(10)
  revisao       Int      @default(1)
  conteudo      String   @db.NVarChar(Max)
  responsavelId Int      @map("responsavel_id")
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @map("created_at") @db.DateTime2
  updatedAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @updatedAt @map("updated_at") @db.DateTime2

  @@unique([garagem, escalaTipo, turno, dataOperacao], map: "UQ_escala_diaria_contexto")
  @@map("escala_diaria")
}
